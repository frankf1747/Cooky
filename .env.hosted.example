# A hosted Supabase project for `npm run dev:hosted` and `npm run seed:hosted`.
# Copy to .env.hosted (gitignored) and fill in from your Supabase project's API settings.
# The URL and publishable key are public by design (the browser sees them; RLS protects the
# data). The secret key bypasses RLS: never commit it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Same as local unless you need otherwise
AI_MODE=fake
CLAUDE_MODEL=claude-haiku-5-5
APP_URL=http://localhost:3000
