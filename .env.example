# Copy to .env.local and fill in. Never commit real values. See docs/TECHNICAL.md.

# Supabase (local: values printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude. Leave ANTHROPIC_API_KEY empty to run every AI unit in fake mode.
ANTHROPIC_API_KEY=
AI_MODE=fake
CLAUDE_MODEL=claude-haiku-5-5
RECEIPT_MODEL=

# Stripe (test mode only: the app refuses to start with a live key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Email (v2) and cron (v2)
RESEND_API_KEY=
CRON_SECRET=

APP_URL=http://localhost:3000
